<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit cleartext traffic for local P2P LiveBridge LAN connectivity -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
